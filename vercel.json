{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron-regsho",
      "schedule": "0 10 * * 1-5"
    }
  ],
  "routes": [
    {
      "src": "/signin",
      "dest": "/signin.html"
    },
    {
      "src": "/desktop",
      "dest": "/desktop.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
